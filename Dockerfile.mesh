FROM python:3.12-slim
WORKDIR /demo
COPY requirements.txt requirements-mesh.txt ./
RUN pip install --no-cache-dir -r requirements-mesh.txt
COPY app ./app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
CMD ["uvicorn", "app.mesh_frontend:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
